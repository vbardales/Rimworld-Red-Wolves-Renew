<?xml version="1.0" encoding="utf-8" ?>
<loadFolders>

  <!-- Pausbrak's own structure, kept: the two integrations only load when the mod they
       target is present. Without this file they would load unconditionally and reference
       types that are not there. -->

  <v1.6>
    <li>/</li>
    <li IfModActive="tachyonite.pawnmorpherpublic">ModIntegrations/Pawnmorpher</li>
    <li IfModActive="Owlchemist.AnimalGear.Equipment">ModIntegrations/AnimalEquipment</li>
  </v1.6>

</loadFolders>

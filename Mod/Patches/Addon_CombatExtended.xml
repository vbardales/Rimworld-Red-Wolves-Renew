<?xml version="1.0" encoding="utf-8" ?>
<!--
  Combat Extended: melee chances for the red wolf.

  The 1.4 original also replaced the race's <tools> with CombatExtended.ToolCE tools. That operation
  selected nothing, because Wolf_Red declares no <tools> of its own (they are inherited from ThingBaseWolf),
  so it never applied; it was removed on 2026-11-03 (owner decision) rather than rewritten.
-->
<Patch>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Combat Extended</li>
        </mods>

        <match Class="PatchOperationSequence">
            <success>Always</success>
            <operations>

                <li Class="PatchOperationAdd">
                    <xpath>Defs/ThingDef[defName="Wolf_Red"]/statBases</xpath>
                    <value>
                        <MeleeDodgeChance>0.30</MeleeDodgeChance>
                        <MeleeCritChance>0.08</MeleeCritChance>
                        <MeleeParryChance>0.04</MeleeParryChance>
                    </value>
                </li>

            </operations>
        </match>
    </Operation>
</Patch>
